# ==========================================
# LabelIntel Environment Configuration
# ==========================================

# Environment Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration (Deferred to Backend Phase)
API_HOST=0.0.0.0
API_PORT=8000

# Computer Vision Engine Settings
CV_USE_GPU=False
CV_OCR_LANG=en
CV_BLUR_LAPLACIAN_THRESHOLD=100.0
CV_BRIGHTNESS_LOW_THRESHOLD=40.0
CV_BRIGHTNESS_HIGH_THRESHOLD=220.0
CV_MIN_IMAGE_DIMENSION=100
CV_MAX_IMAGE_DIMENSION=4096

# Physical Calibration (ArUco)
CV_ARUCO_DICT=DICT_4X4_50
CV_DEFAULT_MARKER_SIZE_MM=20.0

# Storage Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
REPORT_DIR=reports
